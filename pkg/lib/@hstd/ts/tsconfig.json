{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "lib": ["es2020"],
        "sourceMap": true,
        "outDir": "lib",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "declaration": true
    },
    "include": ["src"],
    "exclude": ["lib", "node_modules"]
}
